# Copy to .env and fill in from `supabase status` after `supabase start`.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase signs tokens with this HS256 secret ("JWT secret" in `supabase status`).
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Supabase user id of the first Platform Admin (create the user in Supabase Studio).
PLATFORM_ADMIN_USER_ID=
