<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <!-- Local development only (ADR 0010): never deployed and never started by the tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>catalog-apphost-6f1d2c0e</UserSecretsId>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- Started with `dotnet run`, so the dashboard and orchestrator come from NuGet, not the Aspire CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog.Api/Catalog.Api.csproj" />
  </ItemGroup>

</Project>
